# Caddy — reverse-proxy HTTPS automatique pour ACRA-Demo.
# Le domaine et l'e-mail ACME sont injectés via l'environnement (docker-compose.demo.yml).
# Caddy obtient et renouvelle seul les certificats Let's Encrypt.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	# Taille maximale d'une requête : documents jusqu'à 25 Mo (+ enveloppe multipart),
	# cohérent avec proxyClientMaxBodySize (next.config.js). Au-delà : 413 sans solliciter l'application.
	request_body {
		max_size 26MB
	}

	reverse_proxy app:3000

	# En-têtes de sécurité (complètent ceux posés par l'application).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Redirection www → apex (HTTPS, 301). Nécessite un enregistrement DNS pour
# www.<DOMAIN> pointant vers le VPS (sinon Caddy ne peut pas obtenir le certificat).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
