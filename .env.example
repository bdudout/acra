# =============================================================================
# ACRA — Exemple de configuration (.env.example)
# =============================================================================
#
# Ce fichier est un MODÈLE. Ne le modifiez pas directement.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  DÉMARRAGE RAPIDE                                                       │
# │                                                                         │
# │  Exécutez le script de setup pour créer votre .env automatiquement :   │
# │                                                                         │
# │      ./scripts/setup.sh                                                 │
# │  ou  make setup                                                         │
# │                                                                         │
# │  Le script génère des secrets aléatoires et vous guide pas à pas.      │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Si vous préférez configurer manuellement :
#     cp .env.example .env
# puis remplacez TOUTES les valeurs <À MODIFIER>.
#
# =============================================================================


# ── Base de données PostgreSQL ────────────────────────────────────────────────
#
# Ces trois variables configurent le serveur PostgreSQL lancé par Docker Compose.
#
# POSTGRES_USER : nom d'utilisateur PostgreSQL (non-générique recommandé)
POSTGRES_USER=acra_user

# POSTGRES_PASSWORD : mot de passe PostgreSQL
#   CRITIQUE : doit être aléatoire et unique.
#   Générer : openssl rand -base64 24 | tr -d '/+=' | head -c 32
#   Exemple : K8mXp2vQ9rNs4wYjA7cL3tZeF6bH1dWu
POSTGRES_PASSWORD=CHANGEZ_MOI_openssl_rand_base64_24

# POSTGRES_DB : nom de la base de données
POSTGRES_DB=acra_rm


# ── URL de connexion Prisma ───────────────────────────────────────────────────
#
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
#   Docker Compose : HOST = "db" (nom du service)
#   Local sans Docker : HOST = "localhost"
#   Production distante : HOST = adresse du serveur PostgreSQL
#
# Exemples :
#   Docker : postgresql://acra_user:monpassword@db:5432/acra_rm
#   Local  : postgresql://acra_user:monpassword@localhost:5432/acra_rm
#
DATABASE_URL=postgresql://acra_user:CHANGEZ_MOI@db:5432/acra_rm
# Pool de connexions PostgreSQL (lib/db-pool). Prisma 7 IGNORE connection_limit/pool_timeout dans l'URL.
# Valeurs par défaut adaptées à une instance ; à augmenter avec la charge (sans dépasser max_connections).
# DB_POOL_MAX=10                 # connexions simultanées
# DB_POOL_TIMEOUT_MS=15000       # attente maximale d'une connexion libre (au-delà : erreur, plus de blocage infini)
# DB_POOL_IDLE_MS=30000          # fermeture des connexions inactives
# DB_STATEMENT_TIMEOUT_MS=       # durée maximale d'une requête SQL (vide = non bornée)

# Connexion : échecs tolérés par adresse IP sur 15 min (anti pulvérisation de mots de passe).
# Seuls les ÉCHECS comptent : les connexions réussies d'une entreprise derrière un NAT ne bloquent pas.
# LOGIN_IP_MAX_FAILURES=50


# ── Authentification NextAuth.js ──────────────────────────────────────────────
#
# NEXTAUTH_SECRET : secret pour signer les tokens JWT de session.
#
#   CRITIQUE : doit être aléatoire, long (>= 32 chars), unique par env.
#   Si compromis : tous les tokens existants sont invalidés.
#
#   Générer : openssl rand -base64 48
#   Exemple  : K8mXp2vQ9rNs4wYjA7cL3tZeF6bH1dWuR5nBqPkCsYgMhT0iEaOxJvDl2fU
#
NEXTAUTH_SECRET=CHANGEZ_MOI_openssl_rand_base64_48

# CRON_SECRET : jeton protégeant les endpoints planifiés (/api/cron/*). Le service
# « scheduler » du docker-compose l'utilise pour déclencher, en interne, les snapshots
# de conformité (quotidien) et les alertes/synthèses de dérogations (quotidien/mensuel).
# Généré automatiquement par scripts/setup.sh. Pour un planificateur externe, appelez
# les mêmes URL avec l'en-tête « Authorization: Bearer <CRON_SECRET> ».
# Ex. : curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/conformite-snapshots
# Si absent, les endpoints cron répondent 503 et le scheduler reste inactif.
# CRON_SECRET=CHANGEZ_MOI_openssl_rand_base64_32
# SCHEDULER_TICK=900   # (optionnel) intervalle de vérification du scheduler, en secondes
# TZ=Europe/Paris      # (optionnel) fuseau horaire du scheduler (UTC par défaut)

# NEXTAUTH_URL : URL publique de l'application.
#
#   Développement : http://localhost:3000
#   Production    : https://votre-domaine.com  (HTTPS obligatoire)
#   Reverse proxy : mettez l'URL externe (ex: https://acra.monentreprise.fr)
#
NEXTAUTH_URL=http://localhost:3000


# ── Chiffrement des secrets au repos (recommandé) ────────────────────────────
#
# SECRETS_ENCRYPTION_KEY : clé servant à chiffrer en base (AES-256-GCM) les secrets
#   sensibles configurés via l'admin (Client Secret OIDC, clés/secret SMS).
#
#   Si absente, l'application retombe sur NEXTAUTH_SECRET. Pour une rotation
#   indépendante des secrets de session, définir une clé dédiée ici.
#   CRITIQUE : si cette clé change, les secrets déjà chiffrés deviennent
#   indéchiffrables et devront être ressaisis dans l'interface d'administration.
#
#   Générer : openssl rand -base64 48
#
SECRETS_ENCRYPTION_KEY=


# ── Mode DÉMONSTRATION (ACRA-Demo) ────────────────────────────────────────────
#
# À N'ACTIVER QUE sur une instance dédiée à la démonstration publique. Une instance
# de production ne peut de toute façon PAS basculer en démo (garde-fou : le marqueur
# d'instance est figé au premier démarrage — cf. lib/demo-server resolveInstanceMode).
#
# ACRA_DEMO_MODE : "true" active le mode démo (inscription self-service + organisation
#   isolée par testeur, vérification d'e-mail à l'inscription, purge automatique des
#   données inactives, bandeau + encart explicatifs, plafonds anti-abus).
ACRA_DEMO_MODE=false

# ACRA_DEMO_CONTACT_URL : cible du bouton « Déployer ACRA dans mon SI » du bandeau
#   démo (mailto: ou URL). Ex : mailto:contact@votredomaine.fr
ACRA_DEMO_CONTACT_URL=mailto:contact@example.com

# NEXT_PUBLIC_BASE_URL : URL publique (utilisée pour les métadonnées / SEO).
#   Mettez la même valeur que NEXTAUTH_URL en production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# En mode démo, CRON_SECRET (ci-dessus) est REQUIS : le service « cron » du compose
# appelle POST /api/cron/demo-purge (préavis par e-mail + purge des orgs expirées).
# Un SMTP fonctionnel est également requis (vérification d'e-mail + préavis) :
# à configurer dans l'interface d'administration après le premier démarrage.


# ── Déploiement démo derrière Caddy (docker-compose.demo.yml) ─────────────────
#
# DEMO_DOMAIN : domaine public de la démo (Caddy génère le certificat Let's Encrypt).
#   Ex : demo.votredomaine.fr  (un enregistrement DNS A doit pointer vers le serveur)
DEMO_DOMAIN=demo.example.com

# ACME_EMAIL : e-mail de contact Let's Encrypt (notifications d'expiration).
ACME_EMAIL=admin@example.com

# ─── Bibliothèque documentaire (stockage des fichiers) ───────────────────────
# Backend de stockage des octets : 'local' (défaut, volume disque, mono-instance) ou 's3'
# (stockage objet S3 compatible, OBLIGATOIRE en multi-instance — docs/deploiement-haute-disponibilite.md).
DOCUMENT_STORAGE=local
# Répertoire du volume local (monté en volume Docker en production).
# Défaut : <projet>/.data/documents
# DOCUMENT_STORAGE_DIR=/data/documents
#
# DOCUMENT_STORAGE=s3 : variable manquante → l'application refuse de démarrer (jamais de repli local).
# Bucket recommandé : VERSIONNÉ, CHIFFRÉ AU REPOS, privé (aucune URL publique : l'accès passe par l'app).
# Chiffrement RECOMMANDÉ (ACRA ne chiffre pas les octets lui-même) : de préférence chiffrement par défaut
# du bucket chez le fournisseur ; sinon S3_SSE=AES256 si le fournisseur accepte l'en-tête (à vérifier par
# un téléversement d'essai). Détails : docs/deploiement-haute-disponibilite.md § 4.
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net     # URL http(s)://hôte[:port], sans chemin
# S3_REGION=gra
# S3_BUCKET=acra-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true      # défaut true (https://hôte/bucket/clé) ; false = hôte virtuel (bucket.hôte)
# S3_SSE=AES256                 # désactivé par défaut ; RECOMMANDÉ si accepté : chiffrement côté serveur (x-amz-server-side-encryption: AES256)
# S3_PREFIX=                    # préfixe global facultatif (bucket mutualisé) ; les clés sont déjà <organisation>/<document>/<fichier>
# S3_SESSION_TOKEN=             # identifiants temporaires (facultatif)
# S3_TIMEOUT_MS=30000

# ─── Multi-instance : store partagé (limites de débit + verrouillage de compte) ──
# Vide (défaut) : compteurs en mémoire, propres à l'instance — correct en mono-instance uniquement.
# Défini : Redis partagé par toutes les instances (client intégré, sans dépendance). DEUX modes EXCLUSIFS
# (les deux à la fois → refus de démarrer) — docs/deploiement-haute-disponibilite.md § 5 :
#  1) Point d'entrée unique (Redis managé avec bascule gérée par l'hébergeur, ou Redis unique) :
#     redis://[utilisateur:motdepasse@]hôte[:port][/base]  ou  rediss://… (TLS)
# REDIS_URL=redis://:CHANGEZ_MOI@redis:6379/0
#  2) Redis Sentinel auto-hébergé : 3 sentinelles sur 3 hôtes distincts (quorum 2), essayées dans l'ordre ;
#     le primaire est redécouvert à chaque reconnexion et vérifié (ROLE = master).
# REDIS_SENTINELS=redis1:26379,redis2:26379,redis3:26379
# REDIS_SENTINEL_MASTER=acra    # nom déclaré par « sentinel monitor acra … »
# REDIS_SENTINEL_PASSWORD=      # mot de passe des sentinelles (facultatif)
# REDIS_TLS=0                   # 1 = TLS vers sentinelles et primaire (mode Sentinel ; en mode URL : rediss://)
# Authentification sur Redis : dans REDIS_URL OU ici (deux valeurs différentes → refus de démarrer).
# REDIS_PASSWORD=
# REDIS_USERNAME=               # utilisateur ACL dédié (facultatif)
# Délai (ms) de connexion et de chaque commande : borne l'attente pendant une bascule (défaut 2000, 100–60000).
# REDIS_TIMEOUT_MS=2000
# Redis injoignable au démarrage → l'application REFUSE de démarrer (intégrité avant disponibilité),
# sauf REDIS_OPTIONNEL=1 (repli explicite sur la mémoire locale, avec avertissement). En fonctionnement,
# Redis indisponible → connexions refusées (« fermé ») jusqu'à la reconnexion automatique.
# REDIS_OPTIONNEL=0

# ─── Multi-instance : coexistence de deux versions (mise à jour progressive, lot H1.4) ──
# Profil « ha » uniquement (docker-compose.ha.yml) ; lus par `next build` (arguments de construction de l'image).
# Clé de chiffrement des Server Functions de Next.js, IDENTIQUE pour tous les réplicas et STABLE d'une version
# à l'autre (sinon « Failed to find Server Action » quand un réplica reçoit une requête préparée par un autre).
# Base64 d'une clé AES de 16, 24 ou 32 octets. OBLIGATOIRE en profil « ha ». Ne pas la changer à chaque mise à jour.
#   Générer : openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# L'identifiant de déploiement de Next.js (NEXT_DEPLOYMENT_ID, protection contre le décalage de versions) est la
# révision git ACRA_REVISION, posée par scripts/update-ha.sh : rien à définir ici.
# Mise à jour progressive : scripts/update-ha.sh stable --pitr-confirmed   (ou --backup-cmd "<sauvegarde de la base>")
# Réglages facultatifs du script : ACRA_HA_DRAIN_SECONDS=12 (drainage d'un réplica avant arrêt), ACRA_HA_STOP_TIMEOUT=30,
# ACRA_HEALTH_RETRIES=60 / ACRA_HEALTH_INTERVAL=5 (attente de santé d'un nouveau réplica), ACRA_HA_BACKUP_CMD.
